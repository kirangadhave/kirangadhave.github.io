---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => import.meta.env.DEV || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout title="Blog" description="Writing on reactive notebooks, interactive visualization, and the craft underneath.">
  <section class="mx-auto max-w-2xl px-6 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">Blog</h1>
    <ul class="mt-8 flex flex-col gap-8">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`} class="group block">
              <div class="flex items-center gap-2 font-mono text-xs text-accent">
                <time datetime={post.data.date.toISOString()}>
                  {formatDate(post.data.date)}
                </time>
                {post.data.interactive && (
                  <span class="rounded bg-accent/10 px-2 py-0.5">interactive</span>
                )}
              </div>
              <h2 class="mt-1 text-xl font-medium group-hover:text-accent">
                {post.data.title}
              </h2>
              <p class="mt-1 text-sm opacity-80">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
