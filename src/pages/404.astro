---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Page not found" description="The page you're looking for doesn't exist.">
  <section class="mx-auto flex max-w-2xl flex-col items-start px-6 py-24">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mt-3 opacity-80">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 font-mono text-sm text-accent hover:underline"
    >
      ← Back home
    </a>
  </section>
</BaseLayout>
