---
/**
 * Embeds a whole marimo notebook as a self-contained WASM iframe.
 *
 * The notebook is exported to public/notebooks/<slug>/ by scripts/build-islands.py
 * (slug must be listed in that script's EMBEDS set). Unlike MarimoIsland, the
 * iframe is a fully isolated document with its own Pyodide kernel, so several
 * embeds — or an embed alongside inline islands — can coexist on one page.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  slug: string;
  title: string;
  height?: string;
}

const { slug, title, height = '600px' } = Astro.props;
// Point at index.html explicitly: a static host resolves the bare directory URL
// to it, but `astro dev` doesn't do directory-index resolution for public assets
// and would 404. Relative asset paths inside the notebook resolve the same either way.
const src = `/notebooks/${slug}/index.html`;

// The WASM bundle is generated by scripts/build-islands.py into public/notebooks/.
// In `astro dev` that prebuild step doesn't run, so the bundle may be absent —
// pointing the iframe at a missing path would render the site's full 404 page
// (nav, footer and all) inside the frame. Render a quiet placeholder instead.
const bundleExists = existsSync(
  join(process.cwd(), 'public/notebooks', slug, 'index.html'),
);
---

{
  bundleExists ? (
    <div class="marimo-embed-wrap not-prose" style={`height: ${height}`}>
      <div class="marimo-loading marimo-loading--center" aria-hidden="true">
        <span class="marimo-spinner" />loading marimo…
      </div>
      <iframe
        src={src}
        title={title}
        loading="lazy"
        class="marimo-embed h-full w-full rounded-lg border border-black/10 dark:border-white/10"
        sandbox="allow-scripts allow-same-origin allow-downloads allow-popups"
        onload="this.parentElement.classList.add('marimo-ready')"
      />
    </div>
  ) : (
    <div
      class="not-prose flex items-center justify-center rounded-lg border border-dashed border-black/15 text-sm opacity-60 dark:border-white/15"
      style={`height: ${height}`}
    >
      <span class="font-mono">notebook “{slug}” not built — run pnpm build:islands</span>
    </div>
  )
}
